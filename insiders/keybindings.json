[
    // workbench
    {
        "key": "ctrl+alt+e",
        "command": "revealFileInOS"
    },
    {
        "key": "ctrl+n",
        "command": "explorer.newFile",
        "when": "filesExplorerFocus"
    },
    {
        "key": "ctrl+alt+q",
        "command": "workbench.action.quit"
    },
    {
        "key": "alt+left",
        "command": "workbench.action.previousEditor",
    },
    {
        "key": "alt+right",
        "command": "workbench.action.nextEditor",
    },
    // explore
    {
        "key": "alt+1",
        "command": "workbench.view.explorer"
    },
    // commit
    {
        "key": "alt+2",
        "command": "workbench.view.scm"
    },
    {
        "key": "alt+9",
        "command": "workbench.view.extensions"
    },
    {
        "key": "alt+v",
        "command": "workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "escape",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "!editorTextFocus"
    },
    {
        "key": "ctrl+w",
        "command": "workbench.action.closeActiveEditor",
        "when": "!terminalFocus"
    },
    {
        "key": "ctrl+shift+o",
        "command": "workbench.action.files.openFolder"
    },
    {
        "key": "alt+w",
        "command": "workbench.action.closePanel",
        "when": "panelVisible",
    },
    {
        "key": "ctrl+t",
        "command": "workbench.action.terminal.new",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+w",
        "command": "workbench.action.terminal.kill",
        "when": "terminalFocus"
    },
    {
        "key": "alt+left",
        "command": "workbench.action.terminal.focusPrevious",
        "when": "terminalFocus"
    },
    {
        "key": "alt+right",
        "command": "workbench.action.terminal.focusNext",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+shift+f",
        "command": "filesExplorer.findInFolder",
        "when": "filesExplorerFocus"
    },
    {
        "key": "alt+e",
        "command": "workbench.files.action.showActiveFileInExplorer",
        "when": "editorFocus"
    },
    {
        "key": "alt+q",
        "command": "workbench.action.closeWindow"
    },
    {
        "key": "alt+down",
        "command": "workbench.action.moveEditorToPreviousGroup",
        "when": "editorFocus"
    },
    {
        "key": "alt+up",
        "command": "workbench.action.moveEditorToNextGroup",
        "when": "editorFocus"
    },
    {
        "key": "alt+k",
        "command": "workbench.action.keepEditor",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.pinEditor",
        "when": "config.workbench.editor.showTabs && !editorSticky"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.unpinEditor",
        "when": "activeEditorIsPinned"
    },
    {
        "key": "alt+s",
        "command": "workbench.action.toggleMaximizedPanel"
    },
    {
        "key": "alt+z",
        "command": "workbench.action.navigateBack"
    },
    {
        "key": "alt+f",
        "command": "workbench.action.navigateForward"
    },
    // action on characters
    {
        "key": "ctrl+q",
        "command": "editor.action.deleteLines",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+d",
        "command": "editor.action.changeAll",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+c",
        "command": "editor.action.copyLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+a",
        "command": "editor.action.smartSelect.grow",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+down",
        "command": "editor.action.moveLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+up",
        "command": "editor.action.moveLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+up",
        "command": "editor.gotoPreviousFold",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+down",
        "command": "editor.gotoNextFold",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+[Period]",
        "command": "editor.action.blockComment",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+k ctrl+l",
        "command": "editor.action.transformToLowercase",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+k ctrl+u",
        "command": "editor.action.transformToUppercase",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+k ctrl+s",
        "command": "editor.action.transformToSnakecase",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+k ctrl+c",
        "command": "editor.action.transformToCamelcase",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+k ctrl+k",
        "command": "editor.action.transformToKebabcase",
        "when": "editorTextFocus"
    },
    //git
    {
        "key": "alt+c",
        "command": "git.openChange"
    },
    {
        "key": "alt+h",
        "command": "timeline.focus"
    },
    {
        "key": "alt+b",
        "command": "git.branch"
    },
    {
        "key": "ctrl+pagedown",
        "command": "workbench.action.compareEditor.previousChange",
        "when": "textCompareEditorVisible"
    },
    {
        "key": "ctrl+pageup",
        "command": "workbench.action.compareEditor.nextChange",
        "when": "textCompareEditorVisible"
    },
    {
        "key": "ctrl+pageup",
        "command": "editor.action.dirtydiff.previous",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+pagedown",
        "command": "editor.action.dirtydiff.next",
        "when": "editorTextFocus"
    },
    // goto
    {
        "key": "ctrl+t",
        "command": "workbench.action.gotoSymbol",
        "when": "!terminalFocus"
    },
    {
        "key": "ctrl+shift+e",
        "command": "workbench.action.showAllSymbols"
    },
    // {
    //     "key": "ctrl+shift+t",
    //     "command": "workbench.action.showAllSymbols"
    // },
    // specific search
    {
        "key": "ctrl+enter",
        "command": "search.action.replace",
        "when": "matchFocus && replaceActive && searchViewletVisible"
    },
    {
        "key": "ctrl+enter",
        "command": "search.action.replaceAllInFile",
        "when": "fileMatchFocus && replaceActive && searchViewletVisible"
    },
    {
        "key": "ctrl+enter",
        "command": "search.action.replaceAllInFolder",
        "when": "folderMatchFocus && replaceActive && searchViewletVisible"
    },
    {
        "key": "ctrl+alt+f",
        "command": "search.action.openNewEditor"
    },
    {
        "key": "ctrl+enter",
        "command": "editor.action.openLink",
        "when": "inSearchEditor"
    },
    {
        "key": "shift+f",
        "command": "search.action.openInEditor",
        "when": "hasSearchResult && searchViewletFocus"
    },
    {
        "key": "ctrl+shift+alt+f",
        "command": "workbench.action.quickTextSearch"
    },
    // macro
    {
        "key": "alt+y",
        "command": "macros.vibeCommit"
    },
    // copilot
    {
        "key": "alt+i",
        "command": "workbench.action.chat.openInEditor",
    },
    {
        "key": "alt+s",
        "command": "workbench.action.toggleMaximizedAuxiliaryBar",
        "when": "auxiliaryBarVisible"
    },
    {
        "key": "alt+a",
        "command": "macros.copilotTabOpen",
        "when": "!view.workbench.panel.chat.view.copilot.visible"
    },
    {
        "key": "alt+a",
        "command": "macros.copilotTabClose",
        "when": "view.workbench.panel.chat.view.copilot.visible"
    },
    {
        "key": "alt+g",
        "command": "macros.copilotAgentTabOpen",
        "when": "!auxiliaryBarVisible"
    },
    {
        "key": "alt+g",
        "command": "macros.copilotAgentTabClose",
        "when": "auxiliaryBarVisible"
    },
    {
        "key": "alt+t",
        "command": "macros.copilotThinkTabOpen",
        "when": "!auxiliaryBarVisible"
    },
    {
        "key": "alt+t",
        "command": "macros.copilotThinkTabClose",
        "when": "auxiliaryBarVisible"
    },
    {
        "key": "alt+l",
        "command": "macros.copilotBackgroundAgentTabOpen",
        "when": "!auxiliaryBarVisible"
    },
    {
        "key": "ctrl+m",
        "command": "workbench.action.chat.openModelPicker",
        "when": "view.workbench.panel.chat.view.copilot.visible"
    },
    {
        "key": "ctrl+m",
        "command": "workbench.action.chat.openModelPicker",
        "when": "inlineChatFocused"
    },
    {
        "key": "ctrl+f",
        "command": "workbench.action.chat.history",
        "when": "view.workbench.panel.chat.view.copilot.visible"
    },
    {
        "key": "ctrl+r",
        "command": "workbench.action.chat.openModePicker",
        "when": "view.workbench.panel.chat.view.copilot.visible"
    },
    {
        "key": "ctrl+o",
        "command": "workbench.action.chat.attachContext",
        "when": "view.workbench.panel.chat.view.copilot.visible"
    },
    {
        "key": "ctrl+o",
        "command": "workbench.action.chat.attachContext",
        "when": "inlineChatFocused"
    },
    {
        "key": "ctrl+b",
        "command": "workbench.action.chat.forkConversation",
        "when": "view.workbench.panel.chat.view.copilot.visible"
    },
    {
        "key": "ctrl+u",
        "command": "workbench.action.chat.restoreCheckpoint",
        "when": "view.workbench.panel.chat.view.copilot.visible"
    },
    {
        "key": "ctrl+enter",
        "command": "chatEditor.action.acceptHunk",
        "when": "chatEdits.hasEditorModifications && editorFocus"
    },
    {
        "key": "ctrl+shift+enter",
        "command": "chatEditor.action.accept",
        "when": "chatEdits.hasEditorModifications && editorFocus"
    },
    {
        "key": "ctrl+backspace",
        "command": "chatEditor.action.undoHunk",
        "when": "chatEdits.hasEditorModifications && editorFocus"
    },
    {
        "key": "ctrl+shift+backspace",
        "command": "chatEditor.action.reject",
        "when": "chatEdits.hasEditorModifications && editorFocus"
    },
    {
        "key": "ctrl+shift+i",
        "command": "editor.action.inlineSuggest.trigger"
    }
]
