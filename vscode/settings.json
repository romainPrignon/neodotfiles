{
    // breadcrumbs
    "breadcrumbs.enabled": true,
    // debug
    "debug.openDebug": "openOnSessionStart",
    "debug.openExplorerOnEnd": true,
    // editor
    // editor scroll
    "editor.smoothScrolling": true,
    "editor.fastScrollSensitivity": 10,
    "editor.mouseWheelScrollSensitivity": 3,
    // editor font
    "editor.fontFamily": "'DejaVu Sans Mono', 'Droid Sans Mono'",
    "editor.fontSize": 14.5,
    "editor.lineHeight": 22,
    // editor format
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.codeActionsOnSave": {
        "source.fixAll.format": "explicit",
        "source.fixAll.eslint": "explicit",
    },
    "editor.pasteAs.preferences": [
        "text.plain"
    ],
    // editor completion
    "editor.parameterHints.enabled": false, // might be true if I need to autocomplete param but verbose
    "editor.wordBasedSuggestions": "off", // might be true ??
    "editor.inlineSuggest.enabled": false, // too intrusive
    // editor indent
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120,
    "editor.rulers": [
        120
    ],
    // editor misc
    "editor.minimap.enabled": false,
    "editor.bracketPairColorization.enabled": false,
    "editor.stickyScroll.enabled": true,
    "editor.stickyScroll.maxLineCount": 2,
    "editor.inlayHints.enabled": "off",
    // explorer
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "explorer.autoReveal": false,
    "explorer.openEditors.visible": 1,
    // extentions
    "extensions.ignoreRecommendations": true,
    //files
    "files.autoSave": "onFocusChange",
    "files.insertFinalNewline": false, // handle by editorconfig
    "files.trimTrailingWhitespace": false, // handle by editorconfig
    // files watcher
    "files.watcherExclude": {
        "**/.idea/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/vendor/**": true,
        "**/coverage/**": true,
        "**/dist/**": true
    },
    // git
    "git.untrackedChanges": "separate",
    "git.autofetch": true,
    "git.autofetchPeriod": 360, // 6 min
    // launch
    "launch": {
        "configurations": [
            {
                "name": "debug - node",
                "type": "node",
                "request": "launch",
                "program": "${file}",
                "timeout": 5000
            },
            {
                "name": "debug - python",
                "type": "python",
                "request": "launch",
                "program": "${file}",
                "timeout": 5000
            },
            {
                "name": "debug - deno",
                "type": "node",
                "port": 9229,
                "request": "launch",
                "cwd": "${workspaceFolder}",
                "runtimeExecutable": "deno",
                "runtimeArgs": [
                    "run",
                    "--inspect-brk",
                    "-A",
                    "${file}"
                ],
                "timeout": 5000
            },
            {
                "name": "debug - ts-node",
                "type": "node",
                "port": 9229,
                "request": "launch",
                "cwd": "${workspaceFolder}",
                "runtimeExecutable": "ts-node",
                "runtimeArgs": [
                    "--inspect-brk",
                    "${file}"
                ],
                "timeout": 5000
            },
            {
                "name": "debug:attach - js",
                "type": "node",
                "request": "attach",
                "port": 9229,
                "timeout": 5000
            },
            {
                "name": "debug - php",
                "type": "php",
                "request": "launch",
                "program": "${file}",
                "port": 9000
            }
        ]
    },
    // problems
    "problems.decorations.enabled": false,
    "problems.showCurrentInStatus": true,
    "problems.defaultViewMode": "table",
    // search
    "search.exclude": {
        "**/.idea": true,
        "**/.mypy_cache": true,
        "**/node_modules": true,
        "**/vendor": true,
        "**/coverage": true,
        "**/dist": true
    },
    "search.useIgnoreFiles": true,
    // terminal
    // "terminal.integrated.defaultLocation": "editor", // editor convient pas forcement
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.fontFamily": "Ubuntu Mono",
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.lineHeight": 1.1,
    "terminal.integrated.letterSpacing": 1,
    "terminal.integrated.drawBoldTextInBrightColors": true, // false for solarized light
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.allowMnemonics": true,
    // window
    "window.newWindowDimensions": "inherit",
    "window.openFoldersInNewWindow": "on",
    "window.zoomLevel": 0.6,
    "window.title": "${appName}${separator}${rootName}",
    "window.titleBarStyle": "native",
    "window.customTitleBarVisibility": "never",
    "window.menuBarVisibility": "toggle",
    "window.commandCenter": false,
    // workbench
    "workbench.preferredDarkColorTheme": "Monokai",
    "workbench.preferredLightColorTheme": "Solarized Light",
    "workbench.colorTheme": "Solarized Light",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.startupEditor": "none",
    "workbench.settings.enableNaturalLanguageSearch": false,
    "workbench.view.alwaysShowHeaderActions": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    // workbench editor
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.pinnedTabSizing": "compact",
    "workbench.editor.decorations.colors": true,
    "workbench.editor.tabActionCloseVisibility": false,
    // workbench editor preview
    "workbench.editor.enablePreview": true,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.editor.enablePreviewFromCodeNavigation": false,
    // workbench history
    "workbench.localHistory.enabled": true,
    "workbench.localHistory.maxFileEntries": 30,
    // workbench tree
    "workbench.tree.indent": 20,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.list.defaultFindMode": "filter",
    // diff editor
    "diffEditor.renderSideBySide": false,
    "diffEditor.experimental.showMoves": true,
    // misc
    "telemetry.telemetryLevel": "off",
    "emmet.showExpandedAbbreviation": "inMarkupAndStylesheetFilesOnly",
    "accessibility.voice.speechLanguage": "fr-FR",
    // javascript
    // typescript
    "js/ts.suggest.completeFunctionCalls": true,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "js/ts.reportStyleChecksAsWarnings": false,
    "js/ts.tsserver.maxMemory": 2048,
    "js/ts.format.semicolons": "remove",
    // Python
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "python.analysis.typeCheckingMode": "strict",
    // markdown
    "[markdown]": {
        "editor.wordBasedSuggestions": "matchingDocuments",
        "editor.quickSuggestions": {
            "comments": "on",
            "strings": "on",
            "other": "on"
        }
    },
    // extensions
    "eslint.run": "onSave",
    "macros.list": {
        "comment": [
            "editor.action.commentLine",
            "cursorDown"
        ],
        "debugStop": [
            "workbench.action.debug.stop",
            "workbench.debug.viewlet.action.removeAllBreakpoints"
        ],
        "vibeCommit": [
            "git.stageAllTracked",
            "git.stageAllUntracked",
            "github.copilot.git.generateCommitMessage",
            {
                "command": "$delay",
                "args": {
                    "delay": 500
                }
            },
            "git.commit"
        ],
        "ai": [
            "workbench.action.toggleSidebarVisibility",
            "workbench.action.toggleAuxiliaryBar"
        ],
        "copilotTabOpen": [
            "workbench.action.toggleSidebarVisibility",
            "workbench.action.chat.openask"
        ],
        "copilotTabClose": [
            "workbench.action.toggleSidebarVisibility",
            "workbench.action.toggleAuxiliaryBar"
        ],
        "copilotAgentTabOpen": [
            "workbench.action.toggleSidebarVisibility",
            "workbench.action.chat.openagent"
        ],
        "copilotAgentTabClose": [
            "workbench.action.toggleSidebarVisibility",
            "workbench.action.toggleAuxiliaryBar"
        ],
        "copilotThinkTabOpen": [ // Plan mode
            "workbench.action.toggleSidebarVisibility",
            "workbench.action.chat.openPlan"
        ],
        "copilotThinkTabClose": [ // Plan mode
            "workbench.action.toggleSidebarVisibility",
            "workbench.action.toggleAuxiliaryBar"
        ],
        "terminalOpen": [
            "workbench.action.closeSidebar",
            "workbench.action.closeAuxiliaryBar",
            "workbench.action.terminal.toggleTerminal",
            "workbench.action.toggleMaximizedPanel"
        ],
        "terminalClose": [
            "workbench.action.toggleMaximizedPanel",
            "workbench.action.terminal.toggleTerminal",
            "workbench.action.toggleSidebarVisibility"
        ],
        "jsdoc": [
            {
                "command": "type",
                "args": {
                    "text": "add jsdoc for the selected code. add ONLY @throws directive and nothing else."
                }
            }
        ]
    },
    "material-icon-theme.hidesExplorerArrows": true,
    "dev.containers.defaultExtensions": [
        "EditorConfig.EditorConfig",
        "ctf0.macros",
        "mikestead.dotenv",
        "PKief.material-icon-theme",
        "yatki.vscode-surround"
    ],
    // either use a project specific dotfiles or make a subset for vscode
    "dotfiles.repository": "romainprignon/dotfiles",
    "dotfiles.installCommand": "make install-shell-all install-shell-bash configure-shell-all configure-shell-bash",
    "surround.custom": {
        "log": {
            "label": "log",
            "description": "console.log",
            "disabled": false,
            "snippet": "console.log($TM_SELECTED_TEXT)"
        }
    },
    "redhat.telemetry.enabled": false,
    "indentRainbow.includedLanguages": [
        "python"
    ],
    "indentRainbow.indicatorStyle": "light",
    "turboConsoleLog.dynamicFreemiumPanel": false,
    "turboConsoleLog.isTurboTelemetryEnabled": false,
    // pr
    "githubPullRequests.commentExpandState": "collapseAll",
    "githubPullRequests.focusedMode": "multiDiff",
    "githubPullRequests.pullBranch": "never",
    // copilot
    // copilot - feature
    "github.copilot.enable": { // when true, use ctrl+shift+i to trigger
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    }, // clash avec mon tab
    "github.copilot.nextEditSuggestions.enabled": false,
    "github.copilot.chat.codesearch.enabled": true,
    "github.copilot.chat.githubMcpServer.enabled": true,
    // copilot - style
    "chat.tips.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "chat.editing.confirmEditRequestRemoval": false,
    // copilot - instructions
    "chat.useNestedAgentsMdFiles": true,
